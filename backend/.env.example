# Copier ce fichier en backend/.env et remplir les valeurs. Ne jamais versionner .env.

# Assistant (RAG) : toute API compatible OpenAI. Sans clé, l'assistant répond
# à partir des seuls référentiels.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# Facultatif : origines autorisées à appeler l'API (frontend).
# CORS_ORIGINS=http://127.0.0.1:5000,http://localhost:5000
